[Unit]
Description=Expire only closed dedicated OPEMOS CI artifact copies

[Service]
Type=oneshot
EnvironmentFile=%h/.config/opemos-ci/expiry.env
# The literal reader below is the unchanged canonical descriptor reader, encoded
# as hex to preserve exact bytes in systemd argv. The private unit is the pinned
# installed bootstrap; stage/config are consumed only from verified FD bytes.
ExecStart=/usr/bin/python3 -I -c "import os,sys;exec(bytes.fromhex(sys.argv[1]));p=sys.argv[2];pin,raw=read_verified(p,8388608,expected_sha=os.environ['OPEMOS_OMEN_STAGE_SHA256'],uid=os.getuid());sys.argv=[p,sys.argv[3],'expire'];verified_namespace(raw,p,'__main__')"  %h/.local/libexec/opemos-ci-stage.py %h/.config/opemos-ci/omen.json
CPUQuota=100%
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/media/connor/Games/OPEMOS/CI-artifacts
# Add the exact existing queue WAL directory only at reviewed installation.
# expiry.env needs exact OPEMOS_OMEN_STAGE_SHA256 and OPEMOS_OMEN_CONFIG_SHA256.
# No VM/worker operation is performed by this service.
