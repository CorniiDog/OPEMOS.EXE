{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamOS NVIDIA Builder",
  "version": "0.1.0",
  "identifier": "dev.cornidog.steamos-nvidia-image-builder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SteamOS NVIDIA Builder",
        "width": 900,
        "height": 820,
        "minWidth": 680,
        "minHeight": 720,
        "theme": "Dark",
        "backgroundColor": [13, 17, 23, 255],
        "visible": false,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "build-progress",
        "title": "SteamOS NVIDIA Builder — Progress",
        "url": "build.html",
        "width": 800,
        "height": 720,
        "minWidth": 620,
        "minHeight": 620,
        "theme": "Dark",
        "backgroundColor": [13, 17, 23, 255],
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"]
  }
}
