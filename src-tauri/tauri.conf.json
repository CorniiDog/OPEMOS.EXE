{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamOS NVIDIA Builder",
  "version": "0.1.0",
  "identifier": "dev.cornidog.steamos-nvidia-image-builder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SteamOS NVIDIA Builder",
        "width": 760,
        "height": 800,
        "minWidth": 760,
        "minHeight": 800,
        "theme": "Dark",
        "backgroundColor": [11, 17, 24, 0],
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["underWindowBackground", "acrylic"],
          "state": "followsWindowActiveState",
          "radius": 10,
          "color": [11, 17, 24, 220]
        },
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
