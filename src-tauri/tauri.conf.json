{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamOS NVIDIA Builder",
  "version": "0.1.0",
  "identifier": "dev.cornidog.steamos-nvidia-image-builder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SteamOS NVIDIA Builder",
        "width": 760,
        "height": 900,
        "minWidth": 760,
        "minHeight": 900,
        "theme": "Dark",
        "backgroundColor": [13, 17, 23, 255],
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"]
  }
}
