#cloud-config

hostname: steamos-builder
manage_etc_hosts: true

users:
  - name: builder
    gecos: SteamOS Builder
    groups:
      - wheel
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false

chpasswd:
  expire: false
  users:
    - name: builder
      password: builder
      type: text

ssh_pwauth: true

write_files:
  - path: /etc/steamos-builder-ready
    permissions: "0644"
    content: |
      SteamOS NVIDIA Image Builder appliance
      READY

runcmd:
  - systemctl enable --now sshd
  - echo "STEAMOS_BUILDER_READY" > /dev/ttyAMA0
