#!/usr/bin/env bash

set -euo pipefail

readonly MINIMUM_INSTALL_BYTES=$((12 * 1024 * 1024 * 1024))
readonly REPAIR_DEVICE=/usr/lib/opemos-install-media/repair_device.sh
readonly SUPPORT_ROOT=/usr/lib/opemos-install-media/support
readonly MAINTAINER_ROOT=/usr/lib/opemos-install-media/maintainer
readonly SUPPORT_REVISION_FILE=/usr/lib/opemos-install-media/support-revision
readonly NVIDIA_VERSION_FILE=/usr/lib/opemos-install-media/nvidia-version
readonly LOCK_DIRECTORY=/run/lock

die() {
  printf 'Open OPEMOS installer: %s\n' "$*" >&2
  exit 1
}

ui_stage() {
  printf '# %s\n' "$*" >&2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required recovery tool is missing: $1"
}

for tool in awk blockdev btrfs findmnt flock install lsblk mktemp mount mountpoint readlink sed sha256sum steamos-chroot umount; do
  need "$tool"
done

clean_field() {
  printf '%s' "$1" | tr '\t\r\n' '   ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

recovery_disks() {
  local source resolved target
  for target in /home/deck /home /; do
    source=$(findmnt -nro SOURCE -T "$target" 2>/dev/null || true)
    [[ -n "$source" ]] || continue
    resolved=$(readlink -f -- "$source" 2>/dev/null || true)
    [[ -b "$resolved" ]] || continue
    lsblk -snrpo PATH,TYPE "$resolved" 2>/dev/null |
      awk '$2 == "disk" { print $1 }'
  done | awk 'NF && !seen[$0]++'
}

is_recovery_disk() {
  local device=$1 recovery
  while IFS= read -r recovery; do
    [[ "$device" == "$recovery" ]] && return 0
  done < <(recovery_disks)
  return 1
}

mounted_child() {
  local device=$1 child mountpoint
  while IFS= read -r child; do
    [[ -n "$child" ]] || continue
    while IFS= read -r mountpoint; do
      [[ -n "$mountpoint" ]] && return 0
    done < <(lsblk -nrpo MOUNTPOINTS "$child" 2>/dev/null | sed '/^[[:space:]]*$/d')
    if awk -v wanted="$child" 'NR > 1 && $1 == wanted { found=1 } END { exit !found }' /proc/swaps 2>/dev/null; then
      return 0
    fi
  done < <(lsblk -nrpo PATH "$device" 2>/dev/null)
  return 1
}

canonical_whole_disk() {
  local requested=$1 resolved type
  [[ "$requested" == /dev/* ]] || return 1
  resolved=$(readlink -f -- "$requested" 2>/dev/null || true)
  [[ -b "$resolved" ]] || return 1
  type=$(lsblk -dnro TYPE "$resolved" 2>/dev/null || true)
  [[ "$type" == disk ]] || return 1
  case "$resolved" in
    /dev/loop*|/dev/zram*|/dev/ram*|/dev/nbd*|/dev/sr*) return 1 ;;
  esac
  printf '%s\n' "$resolved"
}

disk_bytes() {
  blockdev --getsize64 "$1" 2>/dev/null
}

disk_identity() {
  local device=$1 bytes majmin diskseq model serial wwn transport
  bytes=$(disk_bytes "$device")
  majmin=$(lsblk -dnro MAJ:MIN "$device" | tr -d '[:space:]')
  diskseq=$(lsblk -dnro DISKSEQ "$device" 2>/dev/null | tr -d '[:space:]' || true)
  model=$(clean_field "$(lsblk -dnro MODEL "$device" 2>/dev/null || true)")
  serial=$(clean_field "$(lsblk -dnro SERIAL "$device" 2>/dev/null || true)")
  wwn=$(clean_field "$(lsblk -dnro WWN "$device" 2>/dev/null || true)")
  transport=$(clean_field "$(lsblk -dnro TRAN "$device" 2>/dev/null || true)")
  printf 'schema=1\ndevice=%s\nmajorMinor=%s\ndiskSequence=%s\nbytes=%s\nmodel=%s\nserial=%s\nwwn=%s\ntransport=%s\n' \
    "$device" "$majmin" "$diskseq" "$bytes" "$model" "$serial" "$wwn" "$transport" |
    sha256sum | awk '{print $1}'
}

eligible_disk() {
  [[ "$(disk_status "$1")" == eligible ]]
}

disk_status() {
  local requested=$1 device bytes ro
  device=$(canonical_whole_disk "$requested") || { printf 'not-whole-physical-disk\n'; return 0; }
  is_recovery_disk "$device" && { printf 'recovery-medium\n'; return 0; }
  ro=$(lsblk -dnro RO "$device" | tr -d '[:space:]')
  [[ "$ro" == 0 ]] || { printf 'read-only\n'; return 0; }
  bytes=$(disk_bytes "$device")
  [[ "$bytes" =~ ^[0-9]+$ ]] || { printf 'capacity-unavailable\n'; return 0; }
  (( bytes >= MINIMUM_INSTALL_BYTES )) || { printf 'too-small\n'; return 0; }
  mounted_child "$device" && { printf 'mounted-or-swap-active\n'; return 0; }
  printf 'eligible\n'
}

has_exact_steamos_layout() {
  local device=$1 index label count
  local -a labels=(esp efi-A efi-B rootfs-A rootfs-B var-A var-B home)
  count=$(lsblk -nrpo PARTN,PARTLABEL,TYPE "$device" |
    awk '$3 == "part" { count++ } END { print count+0 }')
  [[ "$count" == "${#labels[@]}" ]] || return 1
  for offset in "${!labels[@]}"; do
    index=$((offset + 1))
    label=${labels[$offset]}
    count=$(lsblk -nrpo PARTN,PARTLABEL,TYPE "$device" |
      awk -v number="$index" -v wanted="$label" '$1 == number && $2 == wanted && $3 == "part" { count++ } END { print count+0 }')
    [[ "$count" == 1 ]] || return 1
  done
}

partition_by_label() {
  local device=$1 wanted=$2 path label type extra match=""
  while read -r path label type extra; do
    [[ -z "${extra:-}" ]] || return 1
    [[ "$type" == part && "$label" == "$wanted" ]] || continue
    [[ -z "$match" ]] || return 1
    match=$path
  done < <(lsblk -nrpo PATH,PARTLABEL,TYPE "$device")
  [[ -n "$match" && -b "$match" ]] || return 1
  printf '%s\n' "$match"
}

inventory() {
  local candidate device bytes token model serial transport layout
  while IFS= read -r candidate; do
    device=$(canonical_whole_disk "$candidate" 2>/dev/null || true)
    [[ -n "$device" ]] || continue
    eligible_disk "$device" || continue
    bytes=$(disk_bytes "$device")
    token=$(disk_identity "$device")
    model=$(clean_field "$(lsblk -dnro MODEL "$device" 2>/dev/null || true)")
    serial=$(clean_field "$(lsblk -dnro SERIAL "$device" 2>/dev/null || true)")
    transport=$(clean_field "$(lsblk -dnro TRAN "$device" 2>/dev/null || true)")
    layout=fresh
    has_exact_steamos_layout "$device" && layout=steamos
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$device" "$bytes" "$token" "${model:-Unknown model}" \
      "${serial:-Unavailable}" "${transport:-Unknown}" "$layout"
  done < <(lsblk -dnpo PATH,TYPE | awk '$2 == "disk" { print $1 }')
}

inventory_report() {
  local candidate device bytes model status
  while IFS= read -r candidate; do
    device=$(readlink -f -- "$candidate" 2>/dev/null || printf '%s' "$candidate")
    bytes=$(disk_bytes "$device" 2>/dev/null || printf '0')
    model=$(clean_field "$(lsblk -dnro MODEL "$device" 2>/dev/null || true)")
    status=$(disk_status "$candidate")
    printf '%s\t%s\t%s\t%s\n' "$device" "$bytes" "${model:-Unknown model}" "$status"
  done < <(lsblk -dnpo PATH,TYPE | awk '$2 == "disk" { print $1 }')
}

media_info() {
  local support_revision nvidia_version
  [[ -f "$SUPPORT_REVISION_FILE" && ! -L "$SUPPORT_REVISION_FILE" ]] ||
    die "the pinned recovery support revision is unavailable"
  [[ -f "$NVIDIA_VERSION_FILE" && ! -L "$NVIDIA_VERSION_FILE" ]] ||
    die "the pinned recovery NVIDIA version is unavailable"
  support_revision=$(<"$SUPPORT_REVISION_FILE")
  nvidia_version=$(<"$NVIDIA_VERSION_FILE")
  [[ "$support_revision" =~ ^[0-9a-f]{40}$ ]] || die "the pinned recovery support revision is malformed"
  [[ "$nvidia_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] ||
    die "the pinned recovery NVIDIA version is malformed"
  [[ -x "$REPAIR_DEVICE" && ! -L "$REPAIR_DEVICE" ]] ||
    die "the protected Valve installer delegate is unavailable"
  [[ -x "$SUPPORT_ROOT/bootstrap/install_recovery_guardian_to_root.sh" ]] ||
    die "the pinned installed-system recovery guardian is unavailable"
  printf 'schema=1\nsupportRevision=%s\nnvidiaVersion=%s\nstatus=ready\n' \
    "$support_revision" "$nvidia_version"
}

verify_guardian_slot() {
  local device=$1 slot=$2 support_revision=$3 nvidia_version=$4
  local home_device var_device workspace home_mount var_mount payload units
  home_device=$(partition_by_label "$device" home) ||
    die "installed SteamOS home partition is missing or duplicated"
  var_device=$(partition_by_label "$device" "var-$slot") ||
    die "installed SteamOS var-$slot partition is missing or duplicated"
  workspace=$(mktemp -d "$LOCK_DIRECTORY/opemos-guardian-verify-$slot.XXXXXX") ||
    die "could not create the guardian verification workspace"
  chmod 0700 "$workspace"
  home_mount=$workspace/home
  var_mount=$workspace/var
  mkdir -m 0700 "$home_mount" "$var_mount"
  (
    set -e
    cleanup_guardian_verification() {
      mountpoint -q "$var_mount" && umount "$var_mount" || true
      mountpoint -q "$home_mount" && umount "$home_mount" || true
    }
    trap cleanup_guardian_verification EXIT INT TERM
    mount -o ro,noload "$home_device" "$home_mount"
    mount -o ro,noload "$var_device" "$var_mount"
    [[ "$(findmnt -nro SOURCE -T "$home_mount")" == "$home_device" ]]
    [[ "$(findmnt -nro SOURCE -T "$var_mount")" == "$var_device" ]]
    payload=$home_mount/.steamos/open-gpu-kernel-modules-steamos-support/recovery
    units=$var_mount/lib/overlays/etc/upper
    test -x "$payload/bootstrap/recoveryctl.sh"
    test -x "$payload/bootstrap/online_install.sh"
    test -x "$payload/bootstrap/launch_desktop_companion.sh"
    test -x "$payload/bootstrap/launch_interstitial.sh"
    test -x "$payload/bootstrap/run_guardian_with_interstitial.sh"
    test -x "$payload/lib/desktop_update_generations.py"
    test -x "$payload/lib/interstitial_progress.py"
    test -x "$payload/lib/validate_interstitial_binary.py"
    test -x "$payload/lib/run_in_process_group.py"
    test -x "$payload/lib/payload_receipt.py"
    test -x "$payload/lib/atomic_output.py"
    test -f "$payload/trust/desktop-update-signers.json"
    test -f "$units/systemd/system/opemos-nvidia-guardian.service"
    test -f "$units/systemd/system/opemos-interstitial.service"
    test -f "$units/systemd/system/opemos-nvidia-repair.service"
    test -L "$units/systemd/system/multi-user.target.wants/opemos-nvidia-guardian.service"
    test -L "$units/systemd/system/multi-user.target.wants/opemos-interstitial.service"
    test -L "$units/systemd/system/timers.target.wants/opemos-nvidia-repair.timer"
    grep -Fqx 'Environment=HOME=/root' "$units/systemd/system/opemos-nvidia-guardian.service"
    grep -Fqx 'Environment=HOME=/root' "$units/systemd/system/opemos-interstitial.service"
    grep -Fqx 'Environment=HOME=/root' "$units/systemd/system/opemos-nvidia-repair.service"
    test "$(cat "$payload/support-revision")" = "$support_revision"
    test "$(cat "$payload/nvidia-version")" = "$nvidia_version"
  ) || {
    rmdir "$home_mount" "$var_mount" "$workspace" 2>/dev/null || true
    die "installed recovery guardian verification failed for persistent slot-$slot state"
  }
  rmdir "$home_mount" "$var_mount" "$workspace" ||
    die "could not clean the guardian verification workspace"
}

restore_maintainer_home() {
  local device=$1 root_device home_device workspace root_mount home_mount deck_id deck_uid deck_gid source destination
  root_device=$(partition_by_label "$device" rootfs-A) ||
    die "installed SteamOS rootfs-A partition is missing or duplicated"
  home_device=$(partition_by_label "$device" home) ||
    die "installed SteamOS home partition is missing or duplicated"
  [[ -d "$MAINTAINER_ROOT" && ! -L "$MAINTAINER_ROOT" ]] ||
    die "the pinned Maintainer home payload is unavailable"
  for source in opemos-rollback-last-update open-opemos-welcome Open-OPEMOS.desktop opemos.svg; do
    [[ -f "$MAINTAINER_ROOT/$source" && ! -L "$MAINTAINER_ROOT/$source" ]] ||
      die "the pinned Maintainer home payload is incomplete"
  done
  workspace=$(mktemp -d "$LOCK_DIRECTORY/opemos-maintainer-home.XXXXXX") ||
    die "could not create the Maintainer home workspace"
  chmod 0700 "$workspace"
  root_mount=$workspace/root
  home_mount=$workspace/home
  mkdir -m 0700 "$root_mount" "$home_mount"
  (
    set -e
    cleanup_maintainer_home() {
      mountpoint -q "$home_mount" && umount "$home_mount" || true
      mountpoint -q "$root_mount" && umount "$root_mount" || true
    }
    trap cleanup_maintainer_home EXIT INT TERM
    mount -o ro "$root_device" "$root_mount"
    mount -o rw "$home_device" "$home_mount"
    [[ "$(findmnt -nro SOURCE -T "$root_mount")" == "$root_device" ]]
    [[ "$(findmnt -nro SOURCE -T "$home_mount")" == "$home_device" ]]
    deck_id=$(awk -F: '$1 == "deck" {print $3 ":" $4}' "$root_mount/etc/passwd")
    [[ "$deck_id" =~ ^[0-9]+:[0-9]+$ ]]
    deck_uid=${deck_id%:*}
    deck_gid=${deck_id#*:}
    for destination in \
      "$home_mount/deck/tools" \
      "$home_mount/deck/Desktop" \
      "$home_mount/deck/.config/autostart" \
      "$home_mount/deck/.local/share/icons/hicolor/scalable/apps"; do
      install -d -o "$deck_uid" -g "$deck_gid" -m 0755 "$destination"
    done
    install -o "$deck_uid" -g "$deck_gid" -m 0755 "$MAINTAINER_ROOT/opemos-rollback-last-update" "$home_mount/deck/tools/opemos-rollback-last-update"
    install -o "$deck_uid" -g "$deck_gid" -m 0755 "$MAINTAINER_ROOT/open-opemos-welcome" "$home_mount/deck/tools/open-opemos-welcome"
    install -o "$deck_uid" -g "$deck_gid" -m 0755 "$MAINTAINER_ROOT/Open-OPEMOS.desktop" "$home_mount/deck/Desktop/Open-OPEMOS.desktop"
    install -o "$deck_uid" -g "$deck_gid" -m 0644 "$MAINTAINER_ROOT/Open-OPEMOS.desktop" "$home_mount/deck/.config/autostart/Open-OPEMOS.desktop"
    install -o "$deck_uid" -g "$deck_gid" -m 0644 "$MAINTAINER_ROOT/opemos.svg" "$home_mount/deck/.local/share/icons/hicolor/scalable/apps/opemos.svg"
    for source in \
      opemos-rollback-last-update \
      open-opemos-welcome \
      Open-OPEMOS.desktop \
      opemos.svg; do
      case "$source" in
        opemos-rollback-last-update|open-opemos-welcome) destination=$home_mount/deck/tools/$source ;;
        Open-OPEMOS.desktop) destination=$home_mount/deck/Desktop/$source ;;
        opemos.svg) destination=$home_mount/deck/.local/share/icons/hicolor/scalable/apps/$source ;;
      esac
      [[ "$(sha256sum "$destination" | awk '{print $1}')" == "$(sha256sum "$MAINTAINER_ROOT/$source" | awk '{print $1}')" ]]
    done
    [[ "$(sha256sum "$home_mount/deck/.config/autostart/Open-OPEMOS.desktop" | awk '{print $1}')" == "$(sha256sum "$MAINTAINER_ROOT/Open-OPEMOS.desktop" | awk '{print $1}')" ]]
    sync
  ) || {
    rmdir "$root_mount" "$home_mount" "$workspace" 2>/dev/null || true
    die "could not restore Maintainer functionality to the installed home partition"
  }
  rmdir "$root_mount" "$home_mount" "$workspace" ||
    die "could not clean the Maintainer home workspace"
}

install_guardian_slot() {
  local device=$1 slot=$2 support_revision=$3 nvidia_version=$4
  local root_device home_device var_device workspace root_mount home_mount var_mount etc_root
  root_device=$(partition_by_label "$device" "rootfs-$slot") ||
    die "installed SteamOS rootfs-$slot partition is missing or duplicated"
  home_device=$(partition_by_label "$device" home) ||
    die "installed SteamOS home partition is missing or duplicated"
  var_device=$(partition_by_label "$device" "var-$slot") ||
    die "installed SteamOS var-$slot partition is missing or duplicated"
  workspace=$(mktemp -d "$LOCK_DIRECTORY/opemos-guardian-install-$slot.XXXXXX") ||
    die "could not create the guardian installation workspace"
  chmod 0700 "$workspace"
  root_mount=$workspace/root
  home_mount=$workspace/home
  var_mount=$workspace/var
  mkdir -m 0700 "$root_mount" "$home_mount" "$var_mount"
  disable_readonly() {
    mount -o rw "$root_device" "$root_mount" || return 1
    if ! btrfs property set "$root_mount" ro false; then
      umount "$root_mount" || true
      return 1
    fi
    if ! umount "$root_mount"; then
      btrfs property set "$root_mount" ro true || true
      umount "$root_mount" || true
      return 1
    fi
  }
  restore_readonly() {
    if [[ "$(steamos-chroot --no-overlay --disk "$device" --partset "$slot" -- steamos-readonly status)" == enabled ]]; then
      return 0
    fi
    steamos-chroot --no-overlay --disk "$device" --partset "$slot" -- \
      sh -c 'mount -o remount,rw / && steamos-readonly enable'
  }
  disable_readonly || {
    rmdir "$root_mount" "$home_mount" "$var_mount" "$workspace" 2>/dev/null || true
    die "could not disable read-only mode for rootfs-$slot"
  }
  (
    set -e
    cleanup_guardian_installation() {
      mountpoint -q "$var_mount" && umount "$var_mount" || true
      mountpoint -q "$home_mount" && umount "$home_mount" || true
      mountpoint -q "$root_mount" && umount "$root_mount" || true
      restore_readonly >/dev/null 2>&1 || true
    }
    trap cleanup_guardian_installation EXIT INT TERM
    mount -o rw "$root_device" "$root_mount"
    mount -o rw "$home_device" "$home_mount"
    mount -o rw "$var_device" "$var_mount"
    [[ "$(findmnt -nro SOURCE -T "$root_mount")" == "$root_device" ]]
    [[ "$(findmnt -nro SOURCE -T "$home_mount")" == "$home_device" ]]
    [[ "$(findmnt -nro SOURCE -T "$var_mount")" == "$var_device" ]]
    etc_root=$var_mount/lib/overlays/etc/upper
    install -d -o root -g root -m 0755 "$etc_root"
    "$SUPPORT_ROOT/bootstrap/install_recovery_guardian_to_root.sh" \
      --root "$root_mount" \
      --persistent-home-root "$home_mount" \
      --persistent-etc-root "$etc_root" \
      --support-revision "$support_revision" \
      --nvidia "$nvidia_version"
    sync
  ) || {
    rmdir "$root_mount" "$home_mount" "$var_mount" "$workspace" 2>/dev/null || true
    die "installed recovery guardian failed for persistent slot-$slot state"
  }
  restore_readonly || {
    rmdir "$root_mount" "$home_mount" "$var_mount" "$workspace" 2>/dev/null || true
    die "could not confirm read-only mode was restored for rootfs-$slot"
  }
  rmdir "$root_mount" "$home_mount" "$var_mount" "$workspace" ||
    die "could not clean the guardian installation workspace"
}

install_to_disk() {
  local mode=$1 requested=$2 expected_identity=$3 confirmation=$4
  local device current_identity basename majmin phrase

  ui_stage "Validating the selected physical disk. Nothing has been changed yet."
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "installation must be started through sudo"
  case "$mode" in all|system) ;; *) die "unsupported installation mode" ;; esac
  [[ "$expected_identity" =~ ^[0-9a-f]{64}$ ]] || die "selected disk identity is malformed"
  device=$(canonical_whole_disk "$requested") || die "selected target is no longer a whole physical disk"
  eligible_disk "$device" || die "selected disk is mounted, read-only, too small, missing, or is the recovery medium"
  [[ "$mode" != system ]] || has_exact_steamos_layout "$device" ||
    die "reinstall requires one exact recognized SteamOS A/B partition layout"
  current_identity=$(disk_identity "$device")
  [[ "$current_identity" == "$expected_identity" ]] || die "selected disk identity changed; refresh and choose it again"

  basename=${device##*/}
  if [[ "$mode" == all ]]; then
    phrase="ERASE $basename"
  else
    phrase="REINSTALL $basename"
  fi
  [[ "$confirmation" == "$phrase" ]] || die "typed confirmation did not match; nothing changed"
  [[ -f "$REPAIR_DEVICE" && ! -L "$REPAIR_DEVICE" && -x "$REPAIR_DEVICE" ]] ||
    die "the protected Valve installer delegate is unavailable"
  grep -Fqx 'DISK="${STEAMOS_TARGET_DISK:?Open OPEMOS requires an explicit target disk}"' "$REPAIR_DEVICE" ||
    die "the protected Valve installer delegate does not require an explicit target"

  majmin=$(lsblk -dnro MAJ:MIN "$device" | tr ':[:space:]' '__')
  exec 9>"$LOCK_DIRECTORY/opemos-install-$majmin.lock"
  flock -n 9 || die "another installation is already using this target disk"
  eligible_disk "$device" || die "selected disk changed immediately before installation"
  [[ "$(disk_identity "$device")" == "$expected_identity" ]] ||
    die "selected disk identity changed immediately before installation"

  local support_revision nvidia_version slot
  [[ -f "$SUPPORT_REVISION_FILE" && ! -L "$SUPPORT_REVISION_FILE" ]] ||
    die "the pinned recovery support revision is unavailable"
  [[ -f "$NVIDIA_VERSION_FILE" && ! -L "$NVIDIA_VERSION_FILE" ]] ||
    die "the pinned recovery NVIDIA version is unavailable"
  support_revision=$(<"$SUPPORT_REVISION_FILE")
  nvidia_version=$(<"$NVIDIA_VERSION_FILE")
  [[ "$support_revision" =~ ^[0-9a-f]{40}$ ]] || die "the pinned recovery support revision is malformed"
  [[ "$nvidia_version" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] ||
    die "the pinned recovery NVIDIA version is malformed"
  [[ -x "$SUPPORT_ROOT/bootstrap/install_recovery_guardian_to_root.sh" ]] ||
    die "the pinned installed-system recovery guardian is unavailable"

  ui_stage "Installing SteamOS with NVIDIA drivers to $device. Do not power off or disconnect either drive."
  env \
    STEAMOS_TARGET_DISK="$device" \
    NOPROMPT=1 \
    OPEMOS_FAIL_FAST=1 \
    OPEMOS_NO_REBOOT=1 \
    OPEMOS_SKIP_JUPITER_FIRMWARE=1 \
    "$REPAIR_DEVICE" "$mode"

  ui_stage "Valve installation finished. Preparing offline and delayed-network recovery."
  ui_stage "Restoring Maintainer functionality to the installed home partition."
  restore_maintainer_home "$device"
  for slot in A B; do
    ui_stage "Installing the recovery guardian into rootfs-$slot."
    install_guardian_slot "$device" "$slot" "$support_revision" "$nvidia_version"
  done
  ui_stage "Independently verifying recovery-guardian identity in both A/B slots."
  for slot in A B; do
    verify_guardian_slot "$device" "$slot" "$support_revision" "$nvidia_version"
  done
  sync
  ui_stage "Installation and A/B recovery verification completed."
}

case "${1:-}" in
  inventory)
    [[ $# -eq 1 ]] || die "inventory takes no arguments"
    inventory
    ;;
  inventory-report)
    [[ $# -eq 1 ]] || die "inventory-report takes no arguments"
    inventory_report
    ;;
  media-info)
    [[ $# -eq 1 ]] || die "media-info takes no arguments"
    media_info
    ;;
  identity)
    [[ $# -eq 2 ]] || die "identity requires one device"
    device=$(canonical_whole_disk "$2") || die "target is not a whole physical disk"
    eligible_disk "$device" || die "target is not currently eligible"
    disk_identity "$device"
    ;;
  install)
    [[ $# -eq 6 && $5 == --confirm ]] ||
      die "install requires MODE DEVICE IDENTITY --confirm PHRASE"
    install_to_disk "$2" "$3" "$4" "$6"
    ;;
  *)
    die "usage: $0 media-info | inventory | inventory-report | identity DEVICE | install MODE DEVICE IDENTITY --confirm PHRASE"
    ;;
esac
