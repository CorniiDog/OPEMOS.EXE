[Desktop Entry]
Type=Application
Version=1.0
Name=Open OPEMOS
GenericName=Install or Repair OPEMOS
Comment=Choose a target disk and install, reinstall, or recover OPEMOS
Icon=/home/deck/.local/share/icons/hicolor/scalable/apps/opemos.svg
Terminal=false
Exec=/home/deck/tools/open-opemos-welcome
Path=/home/deck
Categories=System;Utility;
StartupNotify=true
X-KDE-AutostartScript=true
X-GNOME-Autostart-enabled=true
