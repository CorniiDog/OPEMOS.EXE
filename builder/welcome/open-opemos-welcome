#!/usr/bin/env bash

set -euo pipefail

readonly HELPER=/usr/lib/opemos-install-media/opemos-install-helper
readonly ROLLBACK=/home/deck/tools/opemos-rollback-last-update
readonly ICON=/home/deck/.local/share/icons/hicolor/scalable/apps/opemos.svg
readonly UI_CONFIG=/usr/share/opemos-install-media/ui
readonly STATE_DIRECTORY=/home/deck/.local/state/open-opemos
readonly LAST_LOG_FILE="$STATE_DIRECTORY/last-install-log"
export GTK_THEME="${GTK_THEME:-Breeze-Dark}"
[[ -d "$UI_CONFIG" ]] && export XDG_CONFIG_HOME="$UI_CONFIG"

opemos_zenity() {
  if [[ -f "$ICON" && ! -L "$ICON" ]]; then
    command zenity --window-icon="$ICON" "$@"
  else
    command zenity "$@"
  fi
}

message() {
  opemos_zenity --info --title="Open OPEMOS" --width=520 --no-wrap --text="$1" || true
}

failure() {
  opemos_zenity --error --title="Open OPEMOS" --width=560 --no-wrap --text="$1" || true
}

human_size() {
  awk -v bytes="$1" 'BEGIN { printf "%.1f GB", bytes / 1000000000 }'
}

choose_action() {
  local media summary
  media=$("$HELPER" media-info 2>/dev/null || true)
  summary=$(printf '%s\n' "$media" | awk -F= '
    $1 == "nvidiaVersion" { nvidia=$2 }
    $1 == "supportRevision" { revision=substr($2, 1, 12) }
    END { if (nvidia != "" && revision != "") printf "NVIDIA %s · recovery %s", nvidia, revision }
  ')
  opemos_zenity --list --radiolist \
    --title="Open OPEMOS" \
    --text="Welcome to OPEMOS\n${summary:+$summary\n}\nChoose what you want to do on this computer." \
    --column="" --column="Action" --column="What it does" \
    --hide-column=2 --print-column=2 \
    --width=760 --height=390 \
    TRUE install "Install OPEMOS — erase one selected disk and install this image" \
    FALSE reinstall "Reinstall OPEMOS — preserve games and personal files on a recognized SteamOS disk" \
    FALSE rollback "Recovery — select a previously working NVIDIA-ready A/B slot" \
    FALSE diagnostics "Diagnostics — review media identity, eligible disks, and the last installation log"
}

prepare_state_directory() {
  if [[ -L "$STATE_DIRECTORY" ]]; then
    failure "The OPEMOS diagnostic directory is an unsafe symbolic link. Installation has not started."
    return 1
  fi
  mkdir -p "$STATE_DIRECTORY"
  chmod 0700 "$STATE_DIRECTORY"
}

last_log() {
  local candidate
  [[ -f "$LAST_LOG_FILE" && ! -L "$LAST_LOG_FILE" ]] || return 1
  IFS= read -r candidate <"$LAST_LOG_FILE"
  [[ "$candidate" == "$STATE_DIRECTORY"/*.log && -f "$candidate" && ! -L "$candidate" ]] || return 1
  printf '%s\n' "$candidate"
}

show_diagnostics() {
  local report inventory latest
  report=$(mktemp /tmp/open-opemos-diagnostics.XXXXXX)
  inventory=$(mktemp /tmp/open-opemos-diagnostic-inventory.XXXXXX)
  {
    printf 'Open OPEMOS installation-media diagnostics\n\n'
    if "$HELPER" media-info; then
      printf '\nEligible whole physical disks\n'
      if "$HELPER" inventory-report >"$inventory" && [[ -s "$inventory" ]]; then
        awk -F '\t' '{ printf "  %s  %.1f GB  %s  [%s]\n", $1, $2 / 1000000000, $3, $4 }' "$inventory"
      else
        printf '  None. The boot media, mounted/read-only media, and disks below 12 GiB are excluded.\n'
      fi
    else
      printf '\nMedia readiness validation failed.\n'
    fi
    if latest=$(last_log); then
      printf '\nLast installation log\n  %s\n' "$latest"
    else
      printf '\nNo installation attempt has been logged in this booted environment.\n'
    fi
  } >"$report" 2>&1
  opemos_zenity --text-info --title="Open OPEMOS diagnostics" --width=780 --height=500 \
    --filename="$report" --ok-label="Back" || true
  if latest=$(last_log); then
    if opemos_zenity --question --title="Installation log" --width=520 \
      --ok-label="View Log" --cancel-label="Back" \
      --text="Open the complete last installation log?"; then
      opemos_zenity --text-info --title="Open OPEMOS installation log" --width=900 --height=600 \
        --filename="$latest" --ok-label="Back" || true
    fi
  fi
  rm -f "$report" "$inventory"
}

choose_disk() {
  local mode=$1 inventory line device bytes token model serial transport layout selection
  local -a rows=()
  inventory=$(mktemp /tmp/open-opemos-inventory.XXXXXX)
  if ! "$HELPER" inventory >"$inventory"; then
    rm -f "$inventory"
    failure "OPEMOS could not inspect the available physical disks. No disk was changed."
    return 1
  fi
  while IFS=$'\t' read -r device bytes token model serial transport layout; do
    [[ -n "$device" && -n "$token" ]] || continue
    [[ "$mode" != system || "$layout" == steamos ]] || continue
    rows+=(FALSE "$device" "$(human_size "$bytes")" "$model" "$serial" "$transport" "${device}|${token}")
  done <"$inventory"
  (( ${#rows[@]} > 0 )) || {
    rm -f "$inventory"
    failure "No eligible target disk was found.\n\nOPEMOS excludes the booted installation media, mounted disks, read-only disks, and disks smaller than 12 GiB. Reinstall also requires one exact SteamOS A/B layout."
    return 1
  }
  selection=$(opemos_zenity --list --radiolist \
    --title="Select installation disk" \
    --text="Choose the whole physical disk OPEMOS may use. The installation media is excluded automatically." \
    --column="" --column="Device" --column="Capacity" --column="Model" --column="Serial" --column="Bus" --column="Identity" \
    --hide-column=7 --print-column=7 \
    --width=920 --height=430 "${rows[@]}") || {
      rm -f "$inventory"
      return 1
    }
  rm -f "$inventory"
  printf '%s\n' "$selection"
}

run_install() {
  local mode=$1 selected device token basename phrase warning log status power_action
  selected=$(choose_disk "$mode") || return 0
  IFS='|' read -r device token <<<"$selected"
  [[ -n "$device" && "$token" =~ ^[0-9a-f]{64}$ ]] || {
    failure "The disk selection was incomplete. Refresh and choose it again."
    return 0
  }
  basename=${device##*/}
  if [[ "$mode" == all ]]; then
    phrase="ERASE $basename"
    warning="Everything on $device will be permanently erased."
  else
    phrase="REINSTALL $basename"
    warning="OPEMOS will replace both OS slots and var data on $device while preserving its recognized home partition."
  fi
  confirmation=$(opemos_zenity --entry \
    --title="Final disk confirmation" \
    --width=620 \
    --text="$warning\n\nThe device identity will be checked again immediately before any change.\nType $phrase exactly to continue.") || return 0
  [[ "$confirmation" == "$phrase" ]] || {
    message "Confirmation did not match. Nothing was changed."
    return 0
  }

  prepare_state_directory || return 0
  log="$STATE_DIRECTORY/install-$(date +%Y%m%d-%H%M%S).log"
  printf '%s\n' "$log" >"$LAST_LOG_FILE"
  chmod 0600 "$LAST_LOG_FILE"
  set +e
  sudo "$HELPER" install "$mode" "$device" "$token" --confirm "$confirmation" 2>&1 |
    tee "$log" |
    opemos_zenity --progress --pulsate --no-cancel --auto-close \
      --title="Installing OPEMOS" \
      --width=620 \
      --text="Installing to $device. Do not power off the computer or disconnect either drive."
  status=${PIPESTATUS[0]}
  set -e
  if (( status == 0 )); then
    power_action=$(opemos_zenity --list --radiolist \
      --title="OPEMOS installation complete" \
      --text="OPEMOS and its A/B recovery guardian were verified.\n\nShut Down is recommended. Remove the installation USB after power-off, then boot from $device. If you restart, remove the USB as the screen turns off or select the installed disk from the boot menu." \
      --column="" --column="Action" --column="What happens next" \
      --hide-column=2 --print-column=2 --width=720 --height=340 \
      TRUE shutdown "Shut down safely, then remove the installation USB" \
      FALSE restart "Restart now; remove the USB during restart or use the boot menu" \
      FALSE stay "Return to the recovery desktop") || power_action=stay
    case "$power_action" in
      shutdown) systemctl poweroff ;;
      restart) systemctl reboot ;;
      stay) ;;
    esac
  else
    failure "Installation stopped safely before completion.\n\nDiagnostic log: $log\n\nDo not boot from the incomplete target until the failure is resolved or installation is run again."
  fi
}

for tool in awk flock sudo tee zenity; do
  command -v "$tool" >/dev/null 2>&1 || {
    printf 'Open OPEMOS requires %s in the recovery environment.\n' "$tool" >&2
    exit 1
  }
done
if [[ ! -x "$HELPER" ]]; then
  failure "The protected OPEMOS installation helper is missing from this media."
  exit 1
fi

exec 8>/tmp/open-opemos-welcome.lock
if ! flock -n 8; then
  message "Open OPEMOS is already running in this recovery session."
  exit 0
fi
prepare_state_directory || exit 1

while true; do
  action=$(choose_action) || exit 0
  case "$action" in
    install) run_install all ;;
    reinstall) run_install system ;;
    rollback)
      if [[ -x "$ROLLBACK" ]]; then
        if command -v konsole >/dev/null 2>&1; then
          konsole -e sudo "$ROLLBACK"
        else
          failure "The recovery terminal is unavailable on this media."
        fi
      else
        failure "The rollback tool is not present on this installation media."
      fi
      ;;
    diagnostics) show_diagnostics ;;
  esac
done
