#cloud-config
write_files:
  - path: /usr/local/sbin/steamos-headless-harness
    permissions: '0700'
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      result='failed'
      reason='unexpected guest failure'
      finish() {
        printf 'STEAMOS_HEADLESS_RESULT {"schemaVersion":1,"status":"%s","reason":"%s","checks":["usb-identity","usb-capacity","usb-helper-protocol","usb-progress","usb-cancellation-cleanup","usb-readback","recovery-ab-rollback","welcome-disk-inventory"]}\n' "$result" "$reason" > /dev/ttyS0
        sync
        poweroff -f
      }
      trap finish EXIT
      disk='/dev/disk/by-id/virtio-STEAMOS_SYNTH_V1'
      unexpected_disk='/dev/disk/by-id/virtio-STEAMOS_WRONG_V1'
      [[ -b "$disk" ]] || { reason='synthetic virtio disk missing'; exit 1; }
      [[ -b "$unexpected_disk" ]] || { reason='unexpected-identity fixture disk missing'; exit 1; }
      welcome_disk='/dev/disk/by-id/virtio-OPEMOS_WELCOME_V1'
      [[ -b "$welcome_disk" ]] || { reason='welcome inventory fixture disk missing'; exit 1; }
      root_source="$(findmnt -n -o SOURCE /)"
      root_device="$(readlink -f "$root_source" 2>/dev/null || printf '%s' "$root_source")"
      test_device="$(readlink -f "$disk")"
      wrong_device="$(readlink -f "$unexpected_disk")"
      helper_protocol='org.steamos-nvidia-builder.usb-writer/1'
      helper_request_id="$(printf 'vm-helper-request' | sha256sum | awk '{print $1}')"
      helper_intent="$(printf 'vm-helper-intent' | sha256sum | awk '{print $1}')"
      helper_identity="$(printf 'STEAMOS_SYNTH_V1:67108864' | sha256sum | awk '{print $1}')"
      helper_authorize() {
        local protocol="$1" request_id="$2" intent="$3" expires="$4" image_hash="$5" image_bytes="$6"
        local candidate="$7" raw_candidate="$8" capacity="$9" identity="${10}" authenticated="${11}" authorized="${12}"
        [[ "$protocol" = "$helper_protocol" ]] || return 1
        [[ "$request_id" =~ ^[0-9a-f]{64}$ && "$intent" =~ ^[0-9a-f]{64}$ ]] || return 1
        [[ "$expires" = 1050 && "$image_hash" =~ ^[0-9a-f]{64}$ && "$image_bytes" = 67108864 ]] || return 1
        [[ "$candidate" = "$test_device" && "$raw_candidate" = "$test_device" ]] || return 1
        [[ "$capacity" = 67108864 && "$identity" = "$helper_identity" ]] || return 1
        [[ "$authenticated" = yes && "$authorized" = yes ]] || return 1
      }
      authorize_usb_target() {
        local candidate="$1" expected_identity="$2" expected_bytes="$3"
        [[ "$expected_identity" = 'STEAMOS_SYNTH_V1' ]] || return 1
        [[ "$candidate" = "$test_device" && "$candidate" != "$root_device" ]] || return 1
        [[ "$(blockdev --getsize64 "$candidate")" = "$expected_bytes" ]] || return 1
      }
      ! authorize_usb_target "$root_device" STEAMOS_SYNTH_V1 67108864 || { reason='guest root disk passed USB authorization'; exit 1; }
      ! authorize_usb_target "$wrong_device" STEAMOS_WRONG_V1 67108864 || { reason='unexpected device identity passed USB authorization'; exit 1; }
      ! authorize_usb_target "$test_device" STEAMOS_SYNTH_V1 67108863 || { reason='undersized capacity boundary passed USB authorization'; exit 1; }
      ! authorize_usb_target "$test_device" STEAMOS_SYNTH_V1 67108865 || { reason='oversized capacity boundary passed USB authorization'; exit 1; }
      authorize_usb_target "$test_device" STEAMOS_SYNTH_V1 67108864 || { reason='exact synthetic USB identity was rejected'; exit 1; }
      source_image=/var/tmp/steamos-synthetic-usb.img
      dd if=/dev/urandom of="$source_image" bs=4M count=16 status=none
      source_hash="$(sha256sum "$source_image" | awk '{print $1}')"
      ! helper_authorize spoof/1 "$helper_request_id" "$helper_intent" 1050 "$source_hash" 67108864 "$test_device" "$test_device" 67108864 "$helper_identity" yes yes || { reason='spoofed helper protocol passed'; exit 1; }
      ! helper_authorize "$helper_protocol" "$helper_request_id" "$helper_intent" 1050 "$source_hash" 67108864 "$wrong_device" "$wrong_device" 67108864 "$helper_identity" yes yes || { reason='spoofed helper device passed'; exit 1; }
      ! helper_authorize "$helper_protocol" "$helper_request_id" "$helper_intent" 1049 "$source_hash" 67108864 "$test_device" "$test_device" 67108864 "$helper_identity" yes yes || { reason='expired helper intent passed'; exit 1; }
      ! helper_authorize "$helper_protocol" "$helper_request_id" "$helper_intent" 1050 "$source_hash" 67108864 "$test_device" "$test_device" 67108864 "$helper_identity" no yes || { reason='unauthenticated helper passed'; exit 1; }
      helper_authorize "$helper_protocol" "$helper_request_id" "$helper_intent" 1050 "$source_hash" 67108864 "$test_device" "$test_device" 67108864 "$helper_identity" yes yes || { reason='exact helper request was rejected'; exit 1; }
      [[ "$(stat -c %s "$source_image")" = "$(blockdev --getsize64 "$test_device")" ]] || {
        reason='exact image/device capacity boundary mismatch'
        exit 1
      }
      copy_usb_image() {
        local cancel_after="$1" block
        for block in $(seq 0 15); do
          if [[ "$cancel_after" != none && "$block" -ge "$cancel_after" ]]; then
            return 130
          fi
          dd if="$source_image" of="$test_device" bs=4M skip="$block" seek="$block" count=1 conv=notrunc status=none
          printf 'STEAMOS_HEADLESS_PROGRESS {"schemaVersion":1,"phase":"writing","bytesCompleted":%s,"bytesTotal":67108864}\n' "$(( (block + 1) * 4194304 ))" > /dev/ttyS0
        done
        sync
      }
      zero_hash="$(dd if=/dev/zero bs=4M count=16 status=none | sha256sum | awk '{print $1}')"
      for cancel_point in 0 8 15; do
        set +e
        copy_usb_image "$cancel_point"
        cancelled_rc=$?
        set -e
        [[ "$cancelled_rc" = 130 ]] || { reason='synthetic USB cancellation boundary was not observed'; exit 1; }
        dd if=/dev/zero of="$test_device" bs=4M count=16 conv=fsync status=none
        cleanup_hash="$(dd if="$test_device" bs=4M count=16 status=none | sha256sum | awk '{print $1}')"
        [[ "$cleanup_hash" = "$zero_hash" ]] || { reason='cancelled synthetic USB was not sanitized'; exit 1; }
      done
      copy_usb_image none
      readback_hash="$(dd if="$test_device" bs=4M count=16 status=none | sha256sum | awk '{print $1}')"
      [[ "$readback_hash" = "$source_hash" ]] || { reason='synthetic USB full readback mismatch'; exit 1; }
      command -v sfdisk >/dev/null || { reason='guest partition tool missing'; exit 1; }
      printf 'label: gpt\nsize=24M, type=0fc63daf-8483-4772-8e79-3d69d8477de4, name=rootfs-A\nsize=24M, type=0fc63daf-8483-4772-8e79-3d69d8477de4, name=rootfs-B\n' | sfdisk "$test_device" >/dev/null
      blockdev --rereadpt "$test_device"
      udevadm settle
      partition_a="$(lsblk -nrpo NAME,PARTLABEL "$test_device" | awk '$2 == "rootfs-A" { print $1 }')"
      partition_b="$(lsblk -nrpo NAME,PARTLABEL "$test_device" | awk '$2 == "rootfs-B" { print $1 }')"
      [[ -b "$partition_a" && -b "$partition_b" && "$partition_a" != "$partition_b" ]] || {
        reason='synthetic recovery A-B partitions are missing or ambiguous'
        exit 1
      }
      dd if=/dev/zero of="$partition_a" bs=1M count=1 conv=fsync status=none
      dd if=/dev/zero of="$partition_b" bs=1M count=1 conv=fsync status=none
      dd if="$partition_b" of=/tmp/rootfs-b.backup bs=1M count=1 status=none
      before="$(sha256sum /tmp/rootfs-b.backup | awk '{print $1}')"
      dd if=/dev/urandom of="$partition_b" bs=1M count=1 conv=fsync status=none
      mutated="$(dd if="$partition_b" bs=1M count=1 status=none | sha256sum | awk '{print $1}')"
      [[ "$mutated" != "$before" ]] || { reason='synthetic recovery mutation did not change B'; exit 1; }
      dd if=/tmp/rootfs-b.backup of="$partition_b" bs=1M count=1 conv=fsync status=none
      restored="$(dd if="$partition_b" bs=1M count=1 status=none | sha256sum | awk '{print $1}')"
      [[ "$restored" = "$before" ]] || { reason='synthetic recovery B rollback mismatch'; exit 1; }
      mkdir /mnt/opemos-seed
      mount -o ro /dev/disk/by-label/cidata /mnt/opemos-seed
      printf '#!/usr/bin/env bash\nexit 1\n' > /usr/local/sbin/steamos-chroot
      chmod 0755 /usr/local/sbin/steamos-chroot
      inventory="$(/mnt/opemos-seed/opemos-install-helper inventory)"
      inventory_device="$(printf '%s\n' "$inventory" | awk -F '\t' 'NF == 7 { print $1 }')"
      inventory_bytes="$(printf '%s\n' "$inventory" | awk -F '\t' 'NF == 7 { print $2 }')"
      inventory_token="$(printf '%s\n' "$inventory" | awk -F '\t' 'NF == 7 { print $3 }')"
      inventory_layout="$(printf '%s\n' "$inventory" | awk -F '\t' 'NF == 7 { print $7 }')"
      [[ "$(printf '%s\n' "$inventory_device" | sed '/^$/d' | wc -l)" = 1 ]] || { reason="welcome helper returned an ambiguous disk inventory: $(/mnt/opemos-seed/opemos-install-helper inventory-report | tr '\n' ';' | head -c 300)"; exit 1; }
      [[ "$(readlink -f "$inventory_device")" = "$(readlink -f "$welcome_disk")" ]] || { reason='welcome helper selected the wrong physical disk'; exit 1; }
      [[ "$inventory_bytes" = 17179869184 ]] || { reason='welcome helper reported the wrong disk capacity'; exit 1; }
      [[ "$inventory_token" =~ ^[0-9a-f]{64}$ ]] || { reason='welcome helper returned a malformed identity token'; exit 1; }
      [[ "$inventory_layout" = fresh ]] || { reason='unformatted welcome target was not offered for fresh installation'; exit 1; }
      [[ -z "$(lsblk -nrpo PATH,TYPE "$welcome_disk" | awk '$2 == "part" { print $1 }')" ]] || { reason='welcome target fixture unexpectedly has partitions'; exit 1; }
      [[ -z "$(lsblk -dnro FSTYPE "$welcome_disk" | tr -d '[:space:]')" ]] || { reason='welcome target fixture unexpectedly has a filesystem'; exit 1; }
      [[ "$(/mnt/opemos-seed/opemos-install-helper identity "$inventory_device")" = "$inventory_token" ]] || { reason='welcome helper identity was not stable'; exit 1; }
      umount /mnt/opemos-seed
      result='passed'
      reason='synthetic USB identity, capacity, helper protocol, progress, cancellation cleanup, readback, recovery A-B rollback, and welcome inventory succeeded'
runcmd:
  - [ /usr/local/sbin/steamos-headless-harness ]
final_message: STEAMOS_HEADLESS_CLOUD_INIT_COMPLETE
